# Copy to .env and fill in. Never commit .env.

# --- Django ---------------------------------------------------------------
SECRET_KEY=change-me
DEBUG=True
# Comma separated, added to localhost/127.0.0.1
ALLOWED_HOSTS=

# --- Supabase Postgres ----------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the "Session pooler" (port 5432) or the direct connection, NOT the
# transaction pooler (port 6543) -- migrations need session-level features.
# Format: postgresql://postgres.<ref>:<password>@<host>:5432/postgres
DATABASE_URL=postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Supabase Storage -----------------------------------------------------
# Project Settings -> API -> Project URL
SUPABASE_URL=https://abcdefghijklm.supabase.co
# Name of the *public* bucket you created for product images
SUPABASE_BUCKET=product-images
# Project Settings -> Storage -> S3 Connection (endpoint + region)
SUPABASE_S3_ENDPOINT=https://abcdefghijklm.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1
# Storage -> S3 Access Keys -> "New access key"
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
